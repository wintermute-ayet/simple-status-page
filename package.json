{
	"name": "simple-status-page",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"deps": "npm ci && cd frontend-vite && npm ci && cd ..",
		"build": "tsc",
		"buildall": "tsc && cd frontend-vite && npm run build && cd ..",
		"lint": "eslint src tests vitest.config.mts --max-warnings 0 && npm run lint --prefix frontend-vite",
		"typecheck": "tsc --noEmit && tsc --project tsconfig.test.json && npm run typecheck --prefix frontend-vite",
		"watch": "tsc && concurrently \"tsc -w\" \"nodemon dist\"",
		"start": "NODE_ENV=production node ./dist/server.js",
		"check-config": "node dist/cli.js check-config",
		"check-monitors": "node dist/cli.js check-monitors",
		"pretest": "npm run build",
		"test": "vitest run",
		"prettier:server": "prettier --write \"src/**/*.ts\"",
		"prettier:frontend": "prettier --write \"frontend-vite/**/*.tsx\"",
		"prettier:all": "npm run prettier:server && npm run prettier:frontend"
	},
	"keywords": [],
	"author": "Florian Brede",
	"license": "MIT",
	"dependencies": {
		"@koa/cors": "^5.0.0",
		"@koa/router": "^12.0.1",
		"axios": "^1.6.2",
		"better-sqlite3": "^11.10.0",
		"console-stamp": "^3.1.2",
		"js-yaml": "^4.1.0",
		"koa": "^2.14.2",
		"koa-bodyparser": "^4.4.1",
		"koa-static": "^5.0.0",
		"nodemailer": "^6.9.7",
		"validator": "^13.11.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.8",
		"@types/js-yaml": "^4.0.9",
		"@types/koa": "^2.13.12",
		"@types/koa__cors": "^4.0.3",
		"@types/koa__router": "^12.0.4",
		"@types/koa-bodyparser": "^4.3.12",
		"@types/koa-static": "^4.0.4",
		"@types/nodemailer": "^6.4.14",
		"@types/node": "^24.0.0",
		"@types/validator": "^13.11.7",
		"eslint": "^10.14.0",
		"globals": "^17.0.0",
		"prettier": "^3.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^7.3.0",
		"vitest": "^5.1.0"
	}
}
